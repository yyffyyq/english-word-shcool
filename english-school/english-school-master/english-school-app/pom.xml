<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>yfy</groupId>
        <artifactId>english-school-master</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>english-school-app</artifactId>
    <name>english-school-app</name>
    <description>启动模块：组装全部业务模块，对外提供原有 /api 接口</description>

    <dependencies>
        <dependency>
            <groupId>yfy</groupId>
            <artifactId>english-school-user</artifactId>
        </dependency>
        <dependency>
            <groupId>yfy</groupId>
            <artifactId>english-school-word</artifactId>
        </dependency>
        <dependency>
            <groupId>yfy</groupId>
            <artifactId>english-school-class</artifactId>
        </dependency>
        <dependency>
            <groupId>yfy</groupId>
            <artifactId>english-school-assignment</artifactId>
        </dependency>
        <dependency>
            <groupId>yfy</groupId>
            <artifactId>english-school-study</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-codegen</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>english-school-master</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>yfy.englishschoolmaster.EnglishSchoolMasterApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
